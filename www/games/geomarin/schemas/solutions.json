{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "propertyNames": {
    "anyOf": [
      {
        "$ref": "places.json"
      },
      {
        "pattern": "^\\$.+"
      }
    ]
  },
  "patternProperties": {
    "^[^\\$]": {
      "type": "array",
      "description": "Solutions for GeoMarin in this region",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of this solution",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "description": "An optional description or extra hint"
          }
        },
        "minProperties": 2,
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}