{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "solutions": {
      "type": "object",
      "description": "A complete list of solutions for GeoMarin",
      "patternProperties": {
        ".+": {
          "type": "object",
          "description": "One possible solution for GeoMarin",
          "properties": {
            "region": {
              "$ref": "places.json",
              "description": "The region where this is located"
            },
            "hint": {
              "type": "string",
              "description": "An optional description or extra hint"
            },
            "level": {
              "description": "The governmental level at which the public space is managed",
              "enum": [
                "national",
                "state",
                "regional",
                "local",
                "private"
              ]
            }
          },
          "minProperties": 3,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^\\$.+": true
  },
  "additionalProperties": false
}