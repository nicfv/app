{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "solutions": {
      "type": "object",
      "description": "A complete list of solutions for GeoMarin",
      "patternProperties": {
        ".+": {
          "type": "object",
          "description": "One possible solution for GeoMarin",
          "properties": {
            "region": {
              "$ref": "places.json",
              "description": "The region where this is located"
            },
            "hint": {
              "type": "string",
              "description": "An optional description or extra hint"
            }
          },
          "minProperties": 2,
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^\\$.+": true
  },
  "additionalProperties": false
}